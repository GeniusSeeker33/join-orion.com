# Browser/public configuration: the existing join-orion.com Supabase project.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-only Vercel environment variables. Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
OPENAI_API_KEY=YOUR_OPENAI_KEY

# Existing ATS / Marketing development Supabase session project.
VITE_MARKETING_DEV_SUPABASE_URL=https://YOUR_ATS_PROJECT.supabase.co
VITE_MARKETING_DEV_SUPABASE_PUBLISHABLE_KEY=YOUR_ATS_PUBLISHABLE_KEY

# Recruiter screening bridge. Server only, scoped to the ATS project above.
ATS_SCREENING_SERVICE_ROLE_KEY=YOUR_ATS_SERVICE_ROLE_KEY

# Isolated previews only. Provision a strong CRON_SECRET securely on the server.
ATS_SCREENING_CRON_ENABLED=false
CRON_SECRET=

# Required on Vercel Preview. Confirm distinct isolated project refs before setting.
ATS_SCREENING_STAGING_CAREERS_REF=
ATS_SCREENING_STAGING_ATS_REF=
